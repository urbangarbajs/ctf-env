myhostname = srv-news-mail.novapress.local
myorigin = /etc/mailname
mydestination = $myhostname, novapress.local, localhost.localdomain, localhost
relayhost =
inet_interfaces = all
inet_protocols = ipv4
smtpd_banner = NovaPress Mail (Postfix)
home_mailbox = mail/
local_transport = local
local_recipient_maps =
alias_maps = hash:/etc/aliases
alias_database = hash:/etc/aliases
